<Window x:Class="ClaudeSessionManager.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeSessionManager.Wpf.Views"
        Title="ClaudeSessionManager" Icon="/Assets/app.ico" Width="1280" Height="720"
        Background="{StaticResource WindowBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1">
            <TabControl x:Name="ModeTabs"
                        SelectionChanged="ModeTabs_SelectionChanged"
                        SelectedIndex="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" Background="Transparent" Margin="4,4,4,0"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource TabInactiveBg}"
                                            BorderBrush="{StaticResource ChromeBorder}"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="3,3,0,0"
                                            Margin="0,0,2,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBg}"/>
                                            <Setter Property="Foreground" Value="{StaticResource OnAccentFg}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabHoverBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="1 패널"/>
                <TabItem Header="2 분할"/>
                <TabItem Header="3 분할"/>
                <TabItem Header="4 분할"/>
            </TabControl>
        </Border>
        <views:SessionSidebar DockPanel.Dock="Left" x:Name="Sidebar" MinWidth="180"/>
        <GridSplitter DockPanel.Dock="Left" Width="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource ChromeBorder}" ShowsPreview="True"
                      ResizeBehavior="PreviousAndCurrent"/>
        <views:SplitGrid x:Name="SplitArea"/>
    </DockPanel>
</Window>

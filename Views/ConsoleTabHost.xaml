<UserControl x:Class="ClaudeSessionManager.Wpf.Views.ConsoleTabHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ClaudeSessionManager.Wpf.Views"
             Background="{StaticResource ChromeBg}">
    <TabControl x:Name="Tabs"
                Background="Transparent" BorderThickness="0"
                SelectionChanged="Tabs_SelectionChanged">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    Background="{StaticResource TabInactiveBg}"
                                    BorderBrush="{StaticResource ChromeBorder}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="3,3,0,0"
                                    Margin="0,0,1,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DocTabSelectedBg}"/>
                                    <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>
    </TabControl>
</UserControl>

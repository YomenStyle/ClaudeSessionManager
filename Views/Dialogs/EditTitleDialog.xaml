<Window x:Class="ClaudeSessionManager.Wpf.Views.Dialogs.EditTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="제목 편집"
        Width="420" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource FgPrimary}">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Label -->
        <TextBlock Grid.Row="0"
                   Text="새 세션 제목"
                   Foreground="{StaticResource FgPrimary}"
                   Opacity="0.85"
                   Margin="0,0,0,6"/>

        <!-- Row 1: TextBox -->
        <TextBox x:Name="TitleBox"
                 Grid.Row="1"
                 Background="{StaticResource ControlBg}"
                 Foreground="{StaticResource FgPrimary}"
                 BorderBrush="{StaticResource ChromeBorder}"
                 BorderThickness="1"
                 Padding="6,4"
                 MaxLength="200"
                 TextChanged="OnTitleChanged"
                 KeyDown="OnTextBoxKeyDown"
                 CaretBrush="{StaticResource FgPrimary}"/>

        <!-- Row 2: Spacer -->

        <!-- Row 3: Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="OkButton"
                    Content="확인"
                    Width="80" Height="28"
                    IsDefault="True"
                    Click="OnOkClick"
                    Background="{StaticResource AccentBg}"
                    Foreground="{StaticResource FgPrimary}"
                    BorderBrush="{StaticResource AccentBg}"
                    BorderThickness="1"
                    Margin="0,0,8,0"/>
            <Button Content="취소"
                    Width="80" Height="28"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Background="{StaticResource ChromeBorder}"
                    Foreground="{StaticResource FgPrimary}"
                    BorderBrush="{StaticResource ChromeBorder}"
                    BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>

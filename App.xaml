<Application x:Class="ClaudeSessionManager.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ChromeBg" Color="#EEEEF2"/>
            <SolidColorBrush x:Key="ChromeBorder" Color="#CCCEDB"/>
            <SolidColorBrush x:Key="FgPrimary" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="FgSecondary" Color="#6E6E6E"/>
            <SolidColorBrush x:Key="TabInactiveBg" Color="#ECECEC"/>
            <SolidColorBrush x:Key="TabHoverBg" Color="#C9DEF5"/>
            <SolidColorBrush x:Key="AccentBg" Color="#007ACC"/>
            <SolidColorBrush x:Key="OnAccentFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DocTabSelectedBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ListSelectedBg" Color="#CCE4F7"/>
            <SolidColorBrush x:Key="ListHoverBg" Color="#E8F0FB"/>
            <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
